FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Public values from the Shopify Buy Button collection embed, not an Admin API token.
# Leave blank to show the coming-soon shop. Redeploy after configuring.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_COLLECTION_ID=

# Public provider token from an App Store Connect campaign link (pt=).
# Optional override; the code already defaults to this verified public token.
# An explicitly empty value disables Apple campaign forwarding.
# NEXT_PUBLIC values are embedded at build time; redeploy after setting this.
NEXT_PUBLIC_APPLE_PROVIDER_TOKEN=129278373
